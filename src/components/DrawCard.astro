---
import type { Draw, OfficialList, RifaResult, WinnerListStatus } from '../lib/types'
import { formatDate, formatPrize } from '../lib/formatters'
import { placeName } from '../lib/markdown'

interface Props {
  draw: Draw
  index: number
  winners?: OfficialList
  listStatus: WinnerListStatus | null
  rifa: RifaResult | null
}

const { draw, index, winners, listStatus, rifa } = Astro.props

// Rifa lookup ran successfully → each main prize is either sold (has a client) or not.
const rifaReady = rifa !== null && !rifa.error
const soldTo = (number: string, place: number) =>
  rifa?.matches.find((m) => m.drawNumber === draw.drawNumber && m.number === number && m.category === placeName(place))
---

<article class="draw-card h-full">
  <div class="flex items-center justify-between">
    <span class="draw-chip">Sorteo {draw.drawNumber}</span>
    <span class="text-xs font-extrabold tracking-[0.14em] uppercase text-cyan-ink">
      {index === 0 ? 'Último' : index === 1 ? 'Anterior' : `#${index + 1}`}
    </span>
  </div>

  <p class="mt-4 mb-0 text-center section-label">Billete ganador</p>
  <p class="draw-winner">{draw.winnerNumber}</p>

  <dl class="m-0">
    <div class="draw-meta">
      <dt>Premio</dt>
      <dd>{formatPrize(draw.prize)}</dd>
    </div>
    <div class="draw-meta">
      <dt>Fecha</dt>
      <dd>{formatDate(draw.date)}</dd>
    </div>
  </dl>

  {winners ? (
    <div class="mt-5">
      <div class="flex items-center justify-between mb-2.5">
        <h3 class="m-0 section-label">Premios principales</h3>
        <a href={`/api/draws/${draw.drawNumber}/winners.md`} target="_blank" class="text-xs font-bold text-cyan-ink hover:text-royal transition-colors">
          Ver Markdown →
        </a>
      </div>
      <div class="overflow-x-auto -mx-1 px-1">
      <table class="prize-table">
        <thead>
          <tr>
            <th class="text-left">Premio</th>
            <th class="text-left">Número</th>
            <th class="text-right">Monto</th>
            <th class="text-right pl-3">Sucursal</th>
            <th class="text-center pl-3">Vendido</th>
          </tr>
        </thead>
        <tbody>
          {winners.mainPrizes.map((p, i) => {
            const sale = soldTo(p.number, p.place)
            const detailId = `sale-${draw.drawNumber}-${i}`
            return (
              <>
                <tr class:list={{ 'is-sold': sale }}>
                  <td class="prize-place">{placeName(p.place)}</td>
                  <td class="prize-num">{p.number}</td>
                  <td class="prize-amount">{formatPrize(p.prize)}</td>
                  <td class="prize-branch">{p.branch ?? '—'}</td>
                  <td class="prize-sold">
                    {sale ? (
                      <button type="button" class="sold-chip" data-sale-toggle={detailId} aria-expanded="false" aria-controls={detailId}>
                        Sí
                      </button>
                    ) : (
                      <span class="sold-no">{rifaReady ? 'No' : '—'}</span>
                    )}
                  </td>
                </tr>
                {sale && (
                  <tr id={detailId} class="sale-detail" hidden>
                    <td colspan="5">
                      <dl>
                        <dt>Cliente</dt>
                        <dd>{sale.cliente}</dd>
                        <dt>Nombre</dt>
                        <dd class="font-bold">{sale.nombre ?? '—'}</dd>
                        <dt>Dirección</dt>
                        <dd>{sale.direccion ?? '—'}</dd>
                        <dt>Factura</dt>
                        <dd>{sale.factura ?? '—'}</dd>
                      </dl>
                    </td>
                  </tr>
                )}
              </>
            )
          })}
        </tbody>
      </table>
      </div>
      {rifa?.error && <p class="mt-2.5 mb-0 text-xs font-semibold text-danger">No se pudo consultar quién compró los números: {rifa.error}</p>}
      <p class="mt-2.5 mb-0 text-xs text-ink-soft">
        + {winners.approximations.length} aproximaciones y {winners.otherPrizes.length} premios más en la lista oficial
      </p>
    </div>
  ) : listStatus === 'not-published' ? (
    <div class="list-notice mt-5">
      <p class="m-0 font-bold text-ink">Lista Oficial aún no publicada</p>
      <p class="mt-1 mb-0 text-sm text-ink-soft">
        La Lotería Nacional todavía no ha subido el PDF con los ganadores de este sorteo. Vuelve a presionar «Forzar actualización» más tarde.
      </p>
      <a href="https://loterianacional.com.ni/sorteo/" target="_blank" class="inline-block mt-2 text-xs font-bold text-cyan-ink hover:text-royal transition-colors">
        Ver en loterianacional.com.ni →
      </a>
    </div>
  ) : listStatus === 'failed' ? (
    <div class="list-notice is-error mt-5">
      <p class="m-0 font-bold text-danger">No se pudo descargar la Lista Oficial</p>
      <p class="mt-1 mb-0 text-sm text-ink-soft">
        El sitio de la Lotería Nacional no respondió a tiempo. Intenta de nuevo con «Forzar actualización».
      </p>
    </div>
  ) : (
    <p class="mt-5 mb-0 py-3 rounded-[14px] bg-mist text-sm text-ink-soft text-center">
      Presiona «Forzar actualización» para cargar la lista oficial de ganadores
    </p>
  )}
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-sale-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const detail = document.getElementById(btn.dataset.saleToggle!)
      if (!detail) return
      detail.hidden = !detail.hidden
      btn.setAttribute('aria-expanded', String(!detail.hidden))
    })
  })
</script>
