<button id="refresh-btn" type="button" class="btn btn-primary inline-flex items-center justify-center gap-2.5">
  <svg id="refresh-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
  </svg>
  <span id="refresh-text">Forzar actualización</span>
</button>
<p id="refresh-status" class="sr-only" role="status" aria-live="polite"></p>

<script>
  const btn = document.getElementById('refresh-btn') as HTMLButtonElement | null
  const icon = document.getElementById('refresh-icon') as SVGElement | null
  const text = document.getElementById('refresh-text') as HTMLSpanElement | null
  const status = document.getElementById('refresh-status') as HTMLParagraphElement | null

  btn?.addEventListener('click', async () => {
    if (!btn || !icon || !text) return
    btn.disabled = true
    text.textContent = 'Actualizando…'
    if (status) status.textContent = 'Descargando listas oficiales'
    icon.classList.add('animate-spin')
    try {
      await fetch('/api/refresh')
      location.reload()
    } catch {
      text.textContent = 'Error — intenta de nuevo'
      btn.disabled = false
      icon.classList.remove('animate-spin')
    }
  })
</script>
