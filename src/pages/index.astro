---
import Layout from '../layouts/Layout.astro'
import DrawList from '../components/DrawList.astro'
import RefreshButton from '../components/RefreshButton.astro'
import { store } from '../lib/store'
import { scrapeLastThreeDraws } from '../lib/scraper'
import { startMonitor } from '../lib/monitor'

startMonitor()

export const prerender = false

if (store.isEmpty()) {
  try {
    const draws = await scrapeLastThreeDraws()
    store.update(draws)
  } catch (err) {
    console.error('[INDEX] Initial scrape failed:', err instanceof Error ? err.message : err)
  }
}

const draws = store.getDraws()
const winners = store.getWinners()
const winnersStatus = store.getAllWinnersStatus()
const rifa = store.getRifa()
const updatedAt = store.getUpdatedAt()
---

<Layout>
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-[clamp(14px,2.4vh,24px)]">
    <div>
      <h2 class="m-0 font-display font-extrabold text-white text-[clamp(22px,3.2vh,30px)] leading-tight tracking-[-0.01em]">
        Resultados recientes
      </h2>
      <p class="mt-1 mb-0 text-sm text-on-royal-soft">
        Últimos {draws.length > 0 ? draws.length : '—'} sorteos publicados
        {updatedAt
          ? ` · ${new Date(updatedAt).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}`
          : ''}
      </p>
    </div>
    <RefreshButton />
  </div>

  <DrawList draws={draws} winners={winners} winnersStatus={winnersStatus} rifa={rifa} />
</Layout>
